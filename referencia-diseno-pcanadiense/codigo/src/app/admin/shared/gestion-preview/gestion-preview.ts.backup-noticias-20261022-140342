export class GestionPreview {

  readonly modulo = input('');
  readonly titulo = input('Vista previa');
  readonly registro = input<unknown>(null);
  readonly lista = input<unknown>(null);
  readonly activo = input(false);

  readonly esPrivado = computed(() =>
    [
      'mesa-de-partes',
      'reclamaciones',
      'accesibilidad',
      'solicitudes',
      'usuarios',
    ].includes(this.modulo())
  );

  readonly descripcion = computed(() =>
    this.esPrivado()
      ? 'Vista del flujo administrativo, sin exponer datos personales.'
      : 'Consulta visual de la información del módulo.'
  );

  private readonly objeto = computed<Record<string, unknown> | null>(() => {
    const valor = this.registro();

    if (this.esPrivado()) return null;
    if (!valor || typeof valor !== 'object' || Array.isArray(valor)) return null;

    if (!this.activo() && this.modulo() !== 'contactos') return null;

    return valor as Record<string, unknown>;
  });

  private texto(clave: string): string {
    const valor = this.objeto()?.[clave];
    return typeof valor === 'string' || typeof valor === 'number'
      ? String(valor)
      : '';
  }

  readonly nombreRegistro = computed(() => {
    const nombres = [
      this.texto('title'),
      this.texto('titulo'),
      this.texto('name'),
      [
        this.texto('names'),
        this.texto('lastNames'),
      ].filter(Boolean).join(' '),
    ];

    return nombres.find(Boolean) ?? '';
  });

  readonly resumen = computed(() =>
    this.texto('excerpt') ||
    this.texto('resumen') ||
    this.texto('description') ||
    this.texto('slogan')
  );

  readonly imagen = computed(() =>
    this.texto('image') || null
  );

  readonly campos = computed<Campo[]>(() => {
    const o = this.objeto();
    if (!o) return [];

    const pares: Array<[string, unknown]> = [
      ['Categoría', o['categoryLabel'] ?? o['category']],
      ['Cargo', o['position']],
      ['Área', o['area']],
      ['Grado', o['grade']],
      ['Programa', o['programa']],
      ['Año', o['anio']],
      ['Fecha', o['createdAt']],
      ['Institución', o['shortName']],
      ['Siglas', o['acronym']],
      ['Eslogan', o['tagline']],
      ['Teléfono', (o['contact'] as Record<string, unknown> | undefined)?.['landline']],
      ['Correo institucional', (o['contact'] as Record<string, unknown> | undefined)?.['emailGeneral']],
      ['Sedes', Array.isArray(o['locations']) ? o['locations'].length : undefined],
    ];

    return pares
      .filter(([, v]) => v !== null && v !== undefined && String(v).trim() !== '')
      .map(([label, valor]) => ({
        label,
        valor: String(valor),
      }));
  });

  readonly cantidad = computed(() => {
    const elementos = this.lista();
    return Array.isArray(elementos) ? elementos.length : 0;
  });

  readonly tarjetas = computed<Tarjeta[]>(() => {
    if (this.esPrivado()) return [];

    const lista = this.lista();

    if (!Array.isArray(lista)) return [];

    return lista.slice(0, 6).map((item: unknown) => {
      const x = item as Record<string, unknown>;

      return {
        titulo: String(
          x['title'] ??
          x['titulo'] ??
          x['nombre'] ??
          x['name'] ??
          (x['names']
            ? `${x['names']} ${x['lastNames'] ?? ''}`
            : 'Registro')
        ),
        detalle: String(
          x['categoryLabel'] ??
          x['position'] ??
          x['programa'] ??
          x['modulo'] ??
          x['estado'] ??
          ''
        ),
      };
    });
  });

  readonly mensajeVacio = computed(() => {
    switch (this.modulo()) {
      case 'comunicados':
        return 'Los comunicados se gestionan desde Noticias';
      case 'documentos':
        return 'No hay documentos en el filtro actual';
      default:
        return 'Sin elementos para previsualizar';
    }
  });

  readonly enlace = computed(() => {
    switch (this.modulo()) {
      case 'noticias':
      case 'comunicados':
        return '/noticias';
      case 'personal':
        return '/nosotros';
      case 'contactos':
        return '/inicio';
      case 'investigaciones':
        return '/repositorio';
      case 'documentos':
        return '/transparencia';
      default:
        return '';
    }
  });
}