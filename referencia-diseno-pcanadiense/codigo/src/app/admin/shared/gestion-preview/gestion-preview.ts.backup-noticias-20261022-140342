import {
  ChangeDetectionStrategy,
  Component,
  computed,
  input,
} from '@angular/core';

interface Campo {
  label: string;
  valor: string;
}

interface Tarjeta {
  titulo: string;
  detalle: string;
}

@Component({
  selector: 'app-gestion-preview',
  standalone: true,
  template: `
    <section class="gp-shell">

      <header class="gp-header">
        <span class="gp-overline">
          PANEL DE VISUALIZACION
        </span>

        <h2>{{ titulo() }}</h2>

        <p>
          {{ descripcion() }}
        </p>
      </header>

      <div class="gp-body">

        @if (esPrivado()) {
          <div class="gp-notice">
            <i class="fa-solid fa-shield-halved"></i>

            <h3>Gestión administrativa</h3>

            <p>
              Este módulo contiene operaciones o registros
              internos. Por seguridad, los datos se consultan
              únicamente desde el panel original.
            </p>
          </div>

          <div class="gp-workflow">
            <div>
              <span>01</span>
              <strong>Consultar</strong>
              <small>Selecciona un registro</small>
            </div>

            <div>
              <span>02</span>
              <strong>Gestionar</strong>
              <small>Revisa y actualiza su estado</small>
            </div>

            <div>
              <span>03</span>
              <strong>Confirmar</strong>
              <small>Guarda desde el formulario original</small>
            </div>
          </div>

        } @else {

          @if (imagen(); as src) {
            <div class="gp-image">
              <img [src]="src" alt="Imagen de vista previa" />
            </div>
          }

          @if (nombreRegistro()) {
            <div class="gp-feature">
              <span class="gp-kicker">
                {{ activo() ? 'BORRADOR EN EDICION' : 'CONTENIDO' }}
              </span>

              <h3>{{ nombreRegistro() }}</h3>

              @if (resumen()) {
                <div
                  class="gp-summary"
                  [innerHTML]="resumen()"
                ></div>
              }
            </div>
          }

          @if (campos().length) {
            <div class="gp-fields">
              @for (campo of campos(); track campo.label) {
                <div class="gp-field">
                  <span>{{ campo.label }}</span>
                  <strong>{{ campo.valor }}</strong>
                </div>
              }
            </div>
          }

          @if (tarjetas().length) {
            <div class="gp-section-heading">
              <h3>Elementos registrados</h3>
              <span>{{ cantidad() }} elementos</span>
            </div>

            <div class="gp-cards">
              @for (item of tarjetas(); track $index) {
                <article class="gp-card">
                  <div class="gp-card-mark">
                    <i class="fa-solid fa-file-lines"></i>
                  </div>

                  <div>
                    <strong>{{ item.titulo }}</strong>

                    @if (item.detalle) {
                      <p>{{ item.detalle }}</p>
                    }
                  </div>
                </article>
              }
            </div>
          }

          @if (!nombreRegistro() && !campos().length && !tarjetas().length) {
            <div class="gp-notice">
              <i class="fa-solid fa-circle-info"></i>

              <h3>{{ mensajeVacio() }}</h3>

              <p>
                Utiliza los controles originales de la
                izquierda para gestionar este módulo.
              </p>
            </div>
          }

        }

      </div>

      <footer class="gp-footer">
        @if (enlace()) {
          <a
            [href]="enlace()"
            target="_blank"
            rel="noopener noreferrer"
          >
            <i class="fa-solid fa-arrow-up-right-from-square"></i>
            Abrir página pública
          </a>
        } @else {
          <span>
            <i class="fa-solid fa-lock"></i>
            Acceso administrativo
          </span>
        }
      </footer>

    </section>
  `,
  styles: `
