# Imagen de verificación con PHP 8.1 y las extensiones que usa el API.
# La imagen oficial php:8.1-cli no trae pdo_mysql, mbstring ni gd, y el proyecto
# los necesita para hablar con MariaDB y para procesar imágenes (medios). Se
# compila una vez y se reutiliza.
#
#   docker build -t plantilla-php81 -f tools/Dockerfile.php81 .
#   docker run --rm -v "$PWD":/app -w /app plantilla-php81 php API/pruebas/ejecutar.php
#
# Para las pruebas que necesitan base de datos, usa la MariaDB del compose
# desde su propio espacio de red:
#   docker run --rm --network container:plantilla_mariadb -v "$PWD":/app -w /app \
#     -e DB_HOST=127.0.0.1 -e DB_PORT=3306 -e DB_NAME=plantilla_cms \
#     -e DB_USER=plantilla -e DB_PASSWORD=plantilla_local \
#     plantilla-php81 php API/pruebas/ejecutar.php

FROM php:8.1-cli

# pdo_mysql necesita el cliente de MySQL, mbstring necesita oniguruma y gd
# necesita libpng/libjpeg/libwebp/freetype para procesar imágenes.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libonig-dev \
        default-libmysqlclient-dev \
        libpng-dev \
        libjpeg-dev \
        libwebp-dev \
        libfreetype6-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install pdo_mysql mbstring gd \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
