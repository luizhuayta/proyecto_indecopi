# Configuración de la plantilla. Copiar a .env y completar.
# NUNCA subir el .env con credenciales reales a un repositorio.

APP_NAME="Portal Institucional"
APP_ORIGIN="http://127.0.0.1:4200"
URL_BASE="https://tudominio.com"
APP_DEBUG=1
APP_CLAVE=
APP_IDIOMA_DEFECTO=es

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=plantilla_cms
DB_USER=plantilla
DB_PASSWORD=plantilla_local

# Carpeta de archivos subidos. Debe quedar FUERA de public_html.
# Si se deja vacio, se usa "almacen" junto a la carpeta del API.
ALMACEN_DIR=

# Correo (SMTP). Los datos de ejemplo no sirven para enviar nada.
SMTP_HOST=
SMTP_PORT=465
SMTP_CIFRADO=ssl
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=
SMTP_REMITENTE_NOMBRE=
